# CityPulse Environment Variables
# Copy this file to .env and fill in your API keys

# TomTom Traffic & Search API Key (from https://developer.tomtom.com)
VITE_TOMTOM_API_KEY=your_tomtom_api_key_here

# Google Gemini API Key (from https://aistudio.google.com)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Cesium Ion Access Token (from https://ion.cesium.com)
VITE_CESIUM_ION_ACCESS_TOKEN=your_cesium_ion_token_here
